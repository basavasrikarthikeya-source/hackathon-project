# Drishti Engine — Frontend Environment Configuration
# Copy this file to .env and fill in your values.

# -- Supabase (Data Layer, Auth & Realtime) --
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://itpfveokpvzcbmoogcui.supabase.co
VITE_SUPABASE_ANON_KEY=

# -- REST Backend (optional: only needed if using FastAPI route instead of Gradio+Realtime) --
# Base URL of your team's backend
# Leave blank to run in Supabase Realtime mode (Gradio worker integration)
VITE_API_BASE_URL=http://localhost:8000

# Set to 'true' to force local simulation mode (fake DEMO_ANSWERS, no real backend call)
# Default is 'false' — routes to real backend when VITE_API_BASE_URL is configured
VITE_USE_MOCK_ENGINE=false
