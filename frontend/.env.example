# Drishti Engine Backend Integration Configuration

# Base URL of your team's backend (e.g., FastAPI, Flask, Express, Django)
# Leave blank to run entirely in client simulation mode
VITE_API_BASE_URL=http://localhost:8000

# Set to 'false' to route all analysis requests to the real backend
# Set to 'true' to force local simulation mode
VITE_USE_MOCK_ENGINE=false
